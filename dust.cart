use std::*

port cam = Camera(vec(0, 0, 0), rot([0, pi/2, 0]), 15)

port num_particles = 20000
port inner_r = 1.5
port outer_r = 10.0
port eps = 0.001
port dt = 0.1
port G = 1
port M = 1
m = 1.0 * M / num_particles
port a = 1
port mass_ratio = 1
port ev = vec(0.8, 0.0)
port golden_angle = 137.5 * pi / 180
state physics_state = none
state central_object = "binary"

# fiber CentralObject = (Binary: Int | Single: Int)

fiber Particle = (
    m: Real
    pos: Vector<Real, 3>
    vel: Vector<Real, 3>
)

init_particles = for i in 0..num_particles {
    # Calculate initial positions
    pow := 2
    r := outer_r * (i / num_particles)^pow + inner_r
    hash := mod(i * (12345 + i), 2001) / 10000.0
    angle_jitter := hash * 2.0 * pi
    phi := (i * golden_angle) + angle_jitter
    x := r * cos(phi)
    y := r * sin(phi)
    z := 0.0
    # Calculate initial velocities
    omega := sqrt(G * M / r^3)
    vec(vx, vy) := omega * vec(-y, x)
    vz := 0.0

    Particle(m, vec(x,y,z), vec(vx, vy, vz))
}
p0 = init_particles

initial_state = {
    time: 0.0
    particles: p0
    acc: acceleration(pos of p0, mass_pos(0.0))
    mpos: mass_pos(0.0)
}

while physics_state == none {
    physics_state <- initial_state
}


f(x, e, mean_anom) = x - e * sin(x) - mean_anom
ecc_anom(t) = {
    e := norm(ev)
    mean_anom := sqrt(G * M / a^3) * t
    iters := fold x := mean_anom for k in 0..24 while abs(f(x, e, mean_anom)) > 1e-10 { x - f(x, e, mean_anom) / f(:x, e, mean_anom) }
    
    iters[rel(-1)]
}

mass_pos(t) = {
    if central_object == "single" then {
        array([vec(0,0,0), vec(0,0,0)])
    }
    else if central_object == "binary" then {
        anom := ecc_anom(t)
        e := norm(ev)
        x := a * (cos(anom) - e)
        y := a * sqrt(1 - e * e) * sin(anom)
        # Secondary position
        x2 := - x / (1.0 + mass_ratio)
        y2 := - y / (1.0 + mass_ratio)
        z2 := 0
        # Primary position
        x1 := - x2 * mass_ratio
        y1 := - y2 * mass_ratio
        z1 := 0
        array([vec(x1, y1, z1), vec(x2, y2, z2)])
    }
}

potential(x, y, z, mpos) = {
    if central_object == "single" then {
        - G * M / sqrt(x^2 + y^2 + z^2 + eps^2)
    }
    else if central_object == "binary" then {
        r1 := mpos[0]
        r2 := mpos[1]
        p1 := vec(x, y, z) - r1
        p2 := vec(x, y, z) - r2
        M1 := M / (1.0 + mass_ratio)
        M2 := mass_ratio * M1

        - G * M1 / sqrt(dot(p1, p1) + eps^2) - G * M2 / sqrt(dot(p2, p2) + eps^2)
    }
}

acceleration(vec(x, y, z), mpos) = {
    ax := -potential(:x, y, z, mpos)
    ay := -potential(x, :y, z, mpos)
    az := -potential(x, y, :z, mpos)
    vec(ax, ay, az)
}

advance(s) = {
    { time, particles, acc, mpos } := s
    pos := pos of particles
    vel := vel of particles

    mpos_next := mass_pos(time + dt)

    vel_half := vel + 0.5 * acc * dt

    pos_next := pos + vel_half * dt

    acc_next := acceleration(pos_next, mpos_next)
    vel_next := vel_half + 0.5 * acc_next * dt
    {
        time: time + dt
        particles: Particle(m, pos_next, vel_next)
        acc: acc_next
        mpos: mpos_next
    }
}


every 0.01 {
    physics_state <- advance(physics_state)
}


star_size = 30 * vec(1, mass_ratio^(1/3))
orbits = canvas3d : { camera: cam } {
    points(pos of physics_state["particles"]) : { size: 3, color: rgb(0.8, 0.8, 0.8) }
    points(physics_state["mpos"][0..1]) : { size: 0 of star_size, color: rgb(1.0, 0.9, 0.0) }
    points(physics_state["mpos"][1..2]) : { size: 1 of star_size, color: rgb(1.0, 0.9 * mass_ratio, 0.0) }
    } with orbit(cam) with dolly(cam)

main = block {
    orbits
}